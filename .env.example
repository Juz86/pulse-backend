# ─── Firebase ─────────────────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# ─── E-mail (Nodemailer via Gmail) ────────────────────────────────────────────
EMAIL_USER=jouw@gmail.com
EMAIL_PASS=app-wachtwoord

# ─── App URLs ─────────────────────────────────────────────────────────────────
# Stel in als jouw Cloudflare Pages URL (bijv. https://pulse-xyz.pages.dev)
APP_URL=https://jouw-app.pages.dev
FRONTEND_URL=https://jouw-app.pages.dev

# ─── Redis berichtenwachtrij (optioneel) ─────────────────────────────────────
# Railway: stel in via dashboard → Add Plugin → Redis
# Waarde is beschikbaar als $REDIS_URL na toevoeging van de plugin
# Zonder deze variabele werkt de app normaal (fallback op Firestore)
REDIS_URL=redis://default:wachtwoord@host:6379

# ─── Sentry error tracking ────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...

# ─── Android Play-updates (optioneel) ────────────────────────────────────────
# Het AAB-versienummer in Google Play. Een hogere waarde markeert een update als
# beschikbaar; een waarde onder MIN_VERSION maakt die update verplicht. De app
# installeert uitsluitend via Google Play In-App Updates.
PULSE_ANDROID_LATEST_VERSION_CODE=23
PULSE_ANDROID_MIN_VERSION_CODE=23

# ─── Publieke feature flags (optioneel) ──────────────────────────────────────
# Alleen booleaanse UI-/uitrolvlaggen. Nieuwe vlaggen zijn in Pulse standaard
# uitgeschakeld totdat je ze hier expliciet activeert.
# Voorbeeld: {"message_editing":true,"new_call_controls":false}
PULSE_FEATURE_FLAGS_JSON={}
# Cloudflare RealtimeKit Call Engine v2. Keep the API token server-side only.
PULSE_REALTIMEKIT_CALLS_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_REALTIMEKIT_APP_ID=
CLOUDFLARE_REALTIMEKIT_API_TOKEN=
CLOUDFLARE_REALTIMEKIT_PRESET_NAME=
